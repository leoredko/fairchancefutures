msgctxt "end.cert_body"
msgid ""
"Nobody can take this back off you, it does not expire, and it does not show "
"up on any record. It is just yours now. The next time somebody tries to sell"
" you a credit repair package, or a landlord quotes you a number, you will "
"know what you are looking at."
msgstr ""
"Nadie te lo puede quitar, no vence y no aparece en ningún registro. Ahora es"
" tuyo. La próxima vez que alguien intente venderte un paquete para arreglar "
"el crédito, o un casero te diga un número, sabrás qué estás viendo."

msgctxt "end.covered"
msgid "What you covered"
msgstr "Lo que estudiaste"

msgctxt "end.reopen"
msgid "Any of them opens again. Re-reading one does not undo anything."
msgstr ""
"Cualquiera de ellas se abre otra vez. Volver a leer una no deshace nada."

msgctxt "end.week_heading"
msgid "The one thing to do with it this week"
msgstr "Lo único que debes hacer con esto esta semana"

msgctxt "end.week_body"
msgid ""
"Ask your coordinator where your birth certificate and Social Security card "
"stand. That is the first lesson, it has a real deadline, and it is the only "
"part of this that somebody else has to start for you."
msgstr ""
"Pregúntale a tu coordinador cómo van tu acta de nacimiento y tu tarjeta del "
"Seguro Social. Esa es la primera lección, tiene una fecha límite real, y es "
"la única parte de todo esto que otra persona tiene que empezar por ti."

msgctxt "end.back_case"
msgid "Back to my case"
msgstr "Volver a mi caso"

msgctxt "display.dock"
msgid "Accessibility"
msgstr "Accesibilidad"

msgctxt "language.dock"
msgid "Language"
msgstr "Idioma"

msgctxt "display.skip"
msgid "Skip to the page"
msgstr "Ir a la página"

msgctxt "display.title"
msgid "Accessibility"
msgstr "Accesibilidad"

msgctxt "display.heading"
msgid "How this looks"
msgstr "Cómo se ve esto"

msgctxt "display.lede"
msgid "These stay on this tablet until somebody changes them."
msgstr "Esto se queda en esta tableta hasta que alguien lo cambie."

msgctxt "display.done"
msgid "Done"
msgstr "Listo"

msgctxt "display.selected"
msgid "Selected"
msgstr "Elegido"

msgctxt "display.theme"
msgid "Color"
msgstr "Colores"

msgctxt "display.theme.dark"
msgid "Dark"
msgstr "Oscuro"

msgctxt "display.theme.dark.note"
msgid "The usual look."
msgstr "El aspecto de siempre."

msgctxt "display.theme.light"
msgid "Light"
msgstr "Claro"

msgctxt "display.theme.light.note"
msgid "Dark writing on a white page."
msgstr "Letras oscuras sobre una página blanca."

msgctxt "display.theme.contrast"
msgid "High contrast"
msgstr "Alto contraste"

msgctxt "display.theme.contrast.note"
msgid "Black and white with yellow. No tints."
msgstr "Blanco y negro con amarillo. Sin tonos suaves."

msgctxt "display.size"
msgid "Text size"
msgstr "Tamaño del texto"

msgctxt "display.size.normal"
msgid "Normal"
msgstr "Tamaño normal"

msgctxt "display.size.normal.note"
msgid "The usual size."
msgstr "El tamaño de siempre."

msgctxt "display.size.large"
msgid "Large"
msgstr "Grande"

msgctxt "display.size.large.note"
msgid "A bit bigger."
msgstr "Un poco más grande."

msgctxt "display.size.xlarge"
msgid "Largest"
msgstr "Muy grande"

msgctxt "display.size.xlarge.note"
msgid "As big as it goes."
msgstr "Lo más grande que se puede."

msgctxt "display.motion"
msgid "Motion"
msgstr "Movimiento"

msgctxt "display.motion.full"
msgid "Normal"
msgstr "Movimiento normal"

msgctxt "display.motion.full.note"
msgid "Screens fade and slide a little."
msgstr "Las pantallas aparecen y se deslizan un poco."

msgctxt "display.motion.reduced"
msgid "Less motion"
msgstr "Menos movimiento"

msgctxt "display.motion.reduced.note"
msgid "Nothing moves on its own."
msgstr "Nada se mueve solo."

msgctxt "display.read"
msgid "Read aloud"
msgstr "Lectura en voz alta"

msgctxt "display.read.off"
msgid "Off"
msgstr "Apagada"

msgctxt "display.read.off.note"
msgid "Nothing is read to you."
msgstr "No se te lee nada."

msgctxt "display.read.on"
msgid "On"
msgstr "Encendida"

msgctxt "display.read.on.note"
msgid ""
"A Listen button on each screen reads it to you. Use headphones in shared "
"spaces."
msgstr ""
"Un botón Escuchar en cada pantalla te la lee. Usa audífonos en los espacios "
"compartidos."

msgctxt "display.dictate"
msgid "Voice typing"
msgstr "Escribir con la voz"

msgctxt "display.dictate.off"
msgid "Off"
msgstr "Apagado"

msgctxt "display.dictate.off.note"
msgid "Nothing listens."
msgstr "Nada escucha."

msgctxt "display.dictate.on"
msgid "On"
msgstr "Encendido"

msgctxt "display.dictate.on.note"
msgid ""
"Adds a Dictate button to the dispute letter on the coordinator's desk. Never"
" on the tablet, and never on account numbers."
msgstr ""
"Agrega un botón Dictar a la carta de disputa en el escritorio del "
"coordinador. Nunca en la tableta, y nunca en números de cuenta."

msgctxt "dictate.start"
msgid "Dictate"
msgstr "Dictar"

msgctxt "dictate.stop"
msgid "Stop dictating"
msgstr "Dejar de dictar"

msgctxt "dictate.listening"
msgid "Listening. The audio stays on this computer."
msgstr "Escuchando. El audio se queda en esta computadora."

msgctxt "dictate.unavailable"
msgid ""
"Voice typing is off. This browser cannot recognize speech on this device "
"without sending the audio out."
msgstr ""
"Escribir con la voz está apagado. Este navegador no puede reconocer la voz "
"en este dispositivo sin enviar el audio a otro lado."

msgctxt "dictate.ready"
msgid "Voice typing is ready. It works on this device only."
msgstr "Escribir con la voz está listo. Funciona solo en este dispositivo."

msgctxt "read.listen"
msgid "Listen"
msgstr "Escuchar"

msgctxt "read.stop"
msgid "Stop"
msgstr "Parar"

msgctxt "read.headphones"
msgid "Use headphones in shared spaces."
msgstr "Usa audífonos en los espacios compartidos."

msgctxt "read.unavailable"
msgid ""
"This tablet has no voice that works without a network, so read aloud is off."
msgstr ""
"Esta tableta no tiene una voz que funcione sin conexión a internet, así que "
"la lectura en voz alta está desactivada."

msgctxt "read.ready"
msgid "Read aloud is ready. The voice stays on this tablet."
msgstr "La lectura en voz alta está lista. La voz se queda en esta tableta."

msgctxt "error.wrong_answer"
msgid "That was not the right answer. Here is another one."
msgstr "Esa no era la respuesta correcta. Aquí tienes otra pregunta."

msgctxt "error.no_record"
msgid ""
"No record here for {display}. Check the number, or ask your counselor to add"
" you."
msgstr ""
"Aquí no hay registro de {display}. Revisa el número, o pídele a tu consejero"
" que te agregue."

msgctxt "error.id_empty"
msgid "Enter your DIN or your NYSID."
msgstr "Escribe tu DIN o tu NYSID."

msgctxt "error.id_letter"
msgid ""
"That looks like a DIN with the facility letter missing. A DIN is two digits,"
" a letter, then four digits, like 98-A-0004."
msgstr ""
"Parece un DIN al que le falta la letra de la instalación. Un DIN son dos "
"dígitos, una letra y cuatro dígitos, como 98-A-0004."

msgctxt "error.id_short"
msgid ""
"That is too short. A DIN looks like 98-A-0004. A NYSID is eight digits, "
"sometimes with a letter on the end."
msgstr ""
"Es demasiado corto. Un DIN se ve como 98-A-0004. Un NYSID son ocho dígitos, "
"a veces con una letra al final."

msgctxt "error.id_bad"
msgid ""
"That is not a DIN or a NYSID. A DIN is two digits, a letter, then four "
"digits, like 98-A-0004. A NYSID is eight digits, sometimes with a letter on "
"the end."
msgstr ""
"Eso no es un DIN ni un NYSID. Un DIN son dos dígitos, una letra y cuatro "
"dígitos, como 98-A-0004. Un NYSID son ocho dígitos, a veces con una letra al"
" final."

msgctxt "error.pin_length"
msgid "Your PIN needs to be {n} numbers."
msgstr "Tu PIN debe tener {n} números."

msgctxt "error.pin_same"
msgid "Pick something other than the same number six times."
msgstr "Elige algo distinto a repetir seis veces el mismo número."

msgctxt "error.pin_run"
msgid "Pick something that is not just counting up or down."
msgstr "Elige algo que no sea solo contar hacia arriba o hacia abajo."

msgctxt "error.pin_own"
msgid ""
"That is part of your own number, which anyone holding your paperwork can "
"read. Pick something else."
msgstr ""
"Eso es parte de tu propio número, y cualquiera que tenga tus papeles puede "
"leerlo. Elige otra cosa."

msgctxt "error.pin_has"
msgid "This account already has a PIN."
msgstr "Esta cuenta ya tiene un PIN."

msgctxt "error.pin_mismatch"
msgid "Those two PINs are not the same. Try again."
msgstr "Los dos PIN no son iguales. Inténtalo otra vez."

msgctxt "error.pin_none"
msgid "This account has no PIN yet."
msgstr "Esta cuenta todavía no tiene un PIN."

msgctxt "error.pin_wrong"
msgid "That PIN is not right. {left} tries left before it locks."
msgstr ""
"Ese PIN no es correcto. Te quedan {left} intentos antes de que se bloquee."

msgctxt "error.locked_wait"
msgid ""
"Too many wrong tries. Try again in about {minutes} minutes, or ask your "
"counselor to reset it."
msgstr ""
"Demasiados intentos fallidos. Inténtalo de nuevo en unos {minutes} minutos, "
"o pídele a tu consejero que lo restablezca."

msgctxt "error.locked_now"
msgid ""
"That PIN was wrong too many times. The account is locked for 15 minutes. "
"Your counselor can reset it sooner."
msgstr ""
"Ese PIN fue incorrecto demasiadas veces. La cuenta está bloqueada por 15 "
"minutos. Tu consejero puede restablecerla antes."

msgctxt "intake.progress"
msgid "{n} of {total}"
msgstr "{n} de {total}"

msgctxt "intake.title"
msgid "Intake questions"
msgstr "Preguntas iniciales"

msgctxt "intake.back"
msgid "Back"
msgstr "Atrás"

msgctxt "intake.saved.title"
msgid "Every answer saves as you give it."
msgstr "Cada respuesta se guarda al momento de darla."

msgctxt "intake.saved.body"
msgid ""
"This app is already on the tablet and it only talks to your own record. Stop"
" halfway, hand the tablet back, come again on Thursday, and it opens on the "
"question you were on."
msgstr ""
"Esta aplicación ya está en la tableta y solo habla con tu propio expediente."
" Si te detienes a la mitad, devuelves la tableta y vuelves el jueves, se "
"abre en la pregunta donde te quedaste."

msgctxt "intake.knows_score.prompt"
msgid "Do you know what your credit score is?"
msgstr "¿Sabes cuál es tu puntaje de crédito?"

msgctxt "intake.knows_score.helper"
msgid "Most people don't. There is no wrong answer here."
msgstr "La mayoría de la gente no lo sabe. No hay respuesta incorrecta."

msgctxt "intake.knows_score.no"
msgid "No"
msgstr "No"

msgctxt "intake.knows_score.roughly"
msgid "Roughly, but not exactly"
msgstr "Más o menos, pero no exactamente"

msgctxt "intake.knows_score.yes"
msgid "Yes"
msgstr "Sí"

msgctxt "intake.knows_how.prompt"
msgid "Do you know how to find out?"
msgstr "¿Sabes cómo averiguarlo?"

msgctxt "intake.knows_how.helper"
msgid "Again, no wrong answer. Most people outside don't either."
msgstr ""
"Otra vez, no hay respuesta incorrecta. La mayoría de la gente afuera tampoco"
" lo sabe."

msgctxt "intake.knows_how.no"
msgid "No"
msgstr "No"

msgctxt "intake.knows_how.some_idea"
msgid "I have some idea"
msgstr "Tengo una idea"

msgctxt "intake.knows_how.yes"
msgid "Yes"
msgstr "Sí"

msgctxt "intake.ever_had_account.prompt"
msgid "Have you ever had a credit card, loan, or account in your name?"
msgstr ""
"¿Alguna vez has tenido una tarjeta de crédito, un préstamo o una cuenta a tu"
" nombre?"

msgctxt "intake.ever_had_account.helper"
msgid "Before you came in counts. A guess is fine, the report settles it."
msgstr ""
"Cuenta lo de antes de entrar. Si no estás seguro, adivina: el informe lo "
"aclara."

msgctxt "intake.ever_had_account.yes"
msgid "Yes, at some point"
msgstr "Sí, en algún momento"

msgctxt "intake.ever_had_account.no"
msgid "No, never"
msgstr "No, nunca"

msgctxt "intake.ever_had_account.unsure"
msgid "I'm not sure"
msgstr "No estoy seguro"

msgctxt "intake.has_bank_account.prompt"
msgid "Do you have a bank account right now?"
msgstr "¿Tienes una cuenta de banco ahora mismo?"

msgctxt "intake.has_bank_account.helper"
msgid "Open, closed, frozen, joint with someone. Any of it is a yes."
msgstr ""
"Abierta, cerrada, congelada o compartida con alguien. Cualquiera de esas "
"cuenta como un sí."

msgctxt "intake.has_bank_account.yes"
msgid "Yes"
msgstr "Sí"

msgctxt "intake.has_bank_account.no"
msgid "No"
msgstr "No"

msgctxt "intake.collections.prompt"
msgid "Is anyone chasing you for money you owe?"
msgstr "¿Alguien te está cobrando dinero que debes?"

msgctxt "intake.collections.helper"
msgid ""
"A collector, a hospital, an old landlord. Not court fines, those are next."
msgstr ""
"Un cobrador, un hospital, un dueño de casa de antes. Las multas de la corte "
"no cuentan aquí, esas vienen después."

msgctxt "intake.collections.none_found"
msgid "Not that I know of"
msgstr "No que yo sepa"

msgctxt "intake.collections.some"
msgid "One or two"
msgstr "Uno o dos"

msgctxt "intake.collections.many"
msgid "More than a few"
msgstr "Más de unos cuantos"

msgctxt "intake.collections.unknown"
msgid "I have no idea"
msgstr "No tengo idea"

msgctxt "intake.obligations.prompt"
msgid "Do you owe anything the court ordered?"
msgstr "¿Debes algo que ordenó la corte?"

msgctxt "intake.obligations.helper"
msgid "Restitution, child support, fines and fees. Pick all that apply."
msgstr ""
"Restitución, manutención de menores, multas y cargos. Marca todo lo que "
"aplique."

msgctxt "intake.obligations.none"
msgid "None that I know of"
msgstr "Nada que yo sepa"

msgctxt "intake.obligations.restitution"
msgid "Restitution"
msgstr "Restitución"

msgctxt "intake.obligations.child_support"
msgid "Child support"
msgstr "Manutención de menores"

msgctxt "intake.obligations.court_fines"
msgid "Court fines or fees"
msgstr "Multas o cargos de la corte"

msgctxt "teach.long.headline"
msgid "Here is the part most people have not been told."
msgstr "Esto es lo que a la mayoría de la gente no le han dicho."

msgctxt "teach.long.0.title"
msgid "You can get all three reports free, by mail"
msgstr "Puedes recibir los tres informes gratis, por correo"

msgctxt "teach.long.0.body"
msgid ""
"One letter to one address covers Equifax, Experian and TransUnion. No "
"internet, no phone, no fee. We fill it in and your coordinator sends it."
msgstr ""
"Una carta a una dirección cubre a Equifax, Experian y TransUnion. Sin "
"internet, sin teléfono, sin costo. Nosotros la llenamos y tu coordinador la "
"envía."

msgctxt "teach.long.1.title"
msgid "You can have your Social Security number blacked out"
msgstr "Puedes pedir que tu número de Seguro Social aparezca tachado"

msgctxt "teach.long.1.body"
msgid ""
"You can require them to leave out the first five digits of your Social when "
"they send your own file. That is the law, not a favour, and it is why you "
"can read the report on this tablet at all."
msgstr ""
"Puedes exigir que omitan los primeros cinco dígitos de tu Seguro Social "
"cuando te envíen tu propio expediente. Es la ley, no un favor, y es la razón"
" por la que puedes leer el informe en esta tableta."

msgctxt "teach.long.2.title"
msgid "It may not come with a score, and that is normal"
msgstr "Puede que no venga con puntaje, y eso es normal"

msgctxt "teach.long.2.body"
msgid ""
"A free report has to show your file. It does not have to show a number. What"
" matters here is what is on the file, not the number somebody puts on it."
msgstr ""
"Un informe gratis tiene que mostrar tu expediente. No tiene que mostrar un "
"número. Lo que importa aquí es lo que hay en el expediente, no el número que"
" alguien le pone."

msgctxt "teach.long.3.title"
msgid "When it arrives, bring it to your coordinator"
msgstr "Cuando llegue, llévaselo a tu coordinador"

msgctxt "teach.long.3.body"
msgid ""
"The reports come back on paper. Your coordinator scans them into your "
"record, and then you can read them right here."
msgstr ""
"Los informes llegan en papel. Tu coordinador los escanea a tu expediente, y "
"después puedes leerlos aquí mismo."

msgctxt "teach.short.headline"
msgid "Quick confirmation, then we start."
msgstr "Una confirmación rápida y empezamos."

msgctxt "teach.short.0.title"
msgid "One letter, all three bureaus, free"
msgstr "Una carta, los tres burós, gratis"

msgctxt "teach.short.0.body"
msgid "We fill it in and your coordinator sends it."
msgstr "Nosotros la llenamos y tu coordinador la envía."

msgctxt "teach.short.1.title"
msgid "Your Social will be blacked out"
msgstr "Tu Seguro Social aparecerá tachado"

msgctxt "teach.short.1.body"
msgid ""
"We ask them to leave out the first five digits, which the law lets you "
"require."
msgstr ""
"Les pedimos que omitan los primeros cinco dígitos, algo que la ley te "
"permite exigir."

msgctxt "teach.short.2.title"
msgid "Bring the paper to your coordinator"
msgstr "Llévale el papel a tu coordinador"

msgctxt "teach.short.2.body"
msgid "They scan it in and then you can read it here."
msgstr "Lo escanean y después puedes leerlo aquí."

msgctxt "teach.title"
msgid "How this works"
msgstr "Cómo funciona"

msgctxt "teach.more.title"
msgid "One more thing nobody tells you"
msgstr "Algo más que nadie te dice"

msgctxt "teach.more.body"
msgid ""
"You do not have one credit score. You have dozens. A landlord, a car dealer "
"and a credit card company each look at a different one, built by a different"
" model, from a different bureau's file."
msgstr ""
"No tienes un solo puntaje de crédito. Tienes docenas. Un dueño de casa, un "
"vendedor de carros y una compañía de tarjetas miran cada uno uno distinto, "
"hecho con un modelo distinto, a partir del expediente de un buró distinto."

msgctxt "teach.more.cta"
msgid "Show me"
msgstr "Muéstrame"

msgctxt "teach.continue"
msgid "Got it, keep going"
msgstr "Entendido, sigamos"

msgctxt "stand.title"
msgid "Where you stand"
msgstr "Dónde estás"

msgctxt "stand.heading"
msgid "Here's where you're starting."
msgstr "Aquí es donde estás empezando."

msgctxt "stand.step.0"
msgid "Getting started"
msgstr "Empezando"

msgctxt "stand.step.1"
msgid "Building"
msgstr "Construyendo"

msgctxt "stand.step.2"
msgid "Strong"
msgstr "Sólido"

msgctxt "stand.road"
msgid ""
"No number. No grade. A position on the road, and the things that move you "
"along it."
msgstr ""
"Sin número. Sin nota. Una posición en el camino, y las cosas que te hacen "
"avanzar."

msgctxt "stand.next"
msgid "See what's happening on my case"
msgstr "Ver qué pasa con mi caso"

msgctxt "stand.nofile.title"
msgid "You don't have a file yet"
msgstr "Todavía no tienes un expediente"

msgctxt "stand.nofile.body"
msgid ""
"That is not the same as bad credit. Empty moves faster than damaged does."
msgstr ""
"Eso no es lo mismo que mal crédito. Un expediente vacío avanza más rápido "
"que uno dañado."

msgctxt "stand.account.title"
msgid "One account, paid on time, starts the clock"
msgstr "Una cuenta, pagada a tiempo, pone a andar el reloj"

msgctxt "stand.account.body"
msgid "Ms. Reyes will set this up with you before you go home."
msgstr "La Sra. Reyes lo preparará contigo antes de que vuelvas a casa."

msgctxt "stand.disputed.title"
msgid "Your file exists and two items are disputed"
msgstr "Tu expediente existe y dos partidas están en disputa"

msgctxt "stand.disputed.body"
msgid "Ms. Reyes approved the letter. The bureaus have to answer."
msgstr "La Sra. Reyes aprobó la carta. Los burós tienen que responder."

msgctxt "stand.running.title"
msgid "One account, paid on time, keeps the clock running"
msgstr "Una cuenta, pagada a tiempo, mantiene el reloj andando"

msgctxt "stand.running.body"
msgid "Set up before release, not after."
msgstr "Se abre antes de la salida, no después."

msgctxt "stand.court.title"
msgid "What the court ordered is tracked separately"
msgstr "Lo que ordenó la corte se lleva por separado"

msgctxt "stand.court.body"
msgid ""
"It matters, and it does not sit in this list pretending to be a credit card."
msgstr ""
"Importa, y no va en esta lista haciéndose pasar por una tarjeta de crédito."

msgctxt "mail.title"
msgid "In the mail"
msgstr "En el correo"

msgctxt "mail.lede"
msgid "Things sent for you, and where each one is."
msgstr "Lo que se envió por ti y en qué punto está cada cosa."

msgctxt "mail.request"
msgid "Your request for your credit reports"
msgstr "Tu solicitud de tus informes de crédito"

msgctxt "mail.dispute"
msgid "Your dispute letter to {bureau}"
msgstr "Tu carta de disputa a {bureau}"

msgctxt "mail.handed"
msgid "Handed in to {who} on {when}"
msgstr "Entregada a {who} el {when}"

msgctxt "mail.with_coordinator"
msgid "Ms. Reyes has it and will post it"
msgstr "La Sra. Reyes la tiene y la enviará"

msgctxt "mail.sent"
msgid "Sent {when} by {who}"
msgstr "Enviado el {when} por {who}"

msgctxt "mail.number"
msgid "Tracking number {number}"
msgstr "Número de rastreo {number}"

msgctxt "mail.accepted"
msgid "The Post Office has it"
msgstr "El Correo ya lo tiene"

msgctxt "mail.transit"
msgid "On its way"
msgstr "En camino"

msgctxt "mail.delivered"
msgid "Delivered"
msgstr "Entregado"

msgctxt "mail.expected"
msgid "Expected by {when}"
msgstr "Se espera para el {when}"

msgctxt "mail.untracked"
msgid ""
"Sent without a tracking number, so there is no way to prove it went. Ask Ms."
" Reyes if you want to send it again."
msgstr ""
"Se envió sin número de rastreo, así que no hay forma de probar que salió. "
"Pregunta a la Sra. Reyes si quieres enviarlo de nuevo."

msgctxt "papers.title"
msgid "Your papers"
msgstr "Tus documentos"

msgctxt "papers.lede"
msgid "The three documents your ID depends on, and where each one stands."
msgstr ""
"Los tres documentos de los que depende tu identificación, y en qué punto "
"está cada uno."

msgctxt "papers.have"
msgid "On file"
msgstr "Archivado"

msgctxt "papers.not_yet"
msgid "Not yet"
msgstr "Todavía no"

msgctxt "papers.on_file"
msgid "Ms. Reyes has this on file."
msgstr "La Sra. Reyes lo tiene archivado."

msgctxt "papers.ssn_ahead"
msgid ""
"The application goes in 120 days before release. That is {n} days from now."
msgstr ""
"La solicitud se presenta 120 días antes de la salida. Eso es dentro de {n} "
"días."

msgctxt "papers.ssn_passed"
msgid ""
"The application goes in 120 days before release. That day has passed, so it "
"is the first thing to do."
msgstr ""
"La solicitud se presenta 120 días antes de la salida. Ese día ya pasó, así "
"que es lo primero que hay que hacer."

msgctxt "papers.birth"
msgid ""
"Ms. Reyes requests this one. It takes weeks, and the ID cannot be applied "
"for without it."
msgstr ""
"La Sra. Reyes pide este. Tarda semanas, y sin él no se puede solicitar la "
"identificación."

msgctxt "papers.id"
msgid ""
"Applied for once the birth certificate and the Social Security card are both"
" on file."
msgstr ""
"Se solicita cuando el certificado de nacimiento y la tarjeta del Seguro "
"Social ya estén archivados."

msgctxt "papers.ssn"
msgid "Social Security card"
msgstr "Tarjeta del Seguro Social"

msgctxt "papers.birth_label"
msgid "Birth certificate"
msgstr "Certificado de nacimiento"

msgctxt "papers.id_label"
msgid "Non-driver ID"
msgstr "Identificación sin licencia de conducir"

msgctxt "case.heading"
msgid "People are working on this while you wait."
msgstr "Hay gente trabajando en esto mientras esperas."

msgctxt "case.title"
msgid "What's happening on my case"
msgstr "Qué pasa con mi caso"

msgctxt "case.suffix"
msgid "Your case"
msgstr "Tu caso"

msgctxt "case.synced"
msgid "Last synced {when}"
msgstr "Última actualización: {when}"

msgctxt "case.just_now"
msgid "just now"
msgstr "ahora mismo"

msgctxt "case.course.finished"
msgid "You finished the credit course"
msgstr "Terminaste el curso de crédito"

msgctxt "case.course.partial"
msgid "The credit course, {done} of {total} done"
msgstr "El curso de crédito, {done} de {total} lecciones hechas"

msgctxt "case.course.new"
msgid "Learn how credit actually works"
msgstr "Aprende cómo funciona el crédito de verdad"

msgctxt "case.course.all"
msgid "All {total} lessons. Any of them opens again whenever you want it."
msgstr "Las {total} lecciones. Cualquiera se abre de nuevo cuando quieras."

msgctxt "case.course.look_back"
msgid "Look back over them"
msgstr "Repasarlas"

msgctxt "case.course.minutes"
msgid "{n} minutes · saves where you stop"
msgstr "{n} minutos · guarda donde te quedes"

msgctxt "case.course.carry_on"
msgid "Carry on"
msgstr "Continuar"

msgctxt "case.course.start"
msgid "Start the course"
msgstr "Empezar el curso"

msgctxt "case.reports.title"
msgid "Your credit reports"
msgstr "Tus informes de crédito"

msgctxt "case.reports.body"
msgid ""
"Read them here, with your Social Security number blacked out. If they have "
"not arrived yet, this tells you that too."
msgstr ""
"Léelos aquí, con tu número de Seguro Social tachado. Si todavía no han "
"llegado, aquí también te lo dice."

msgctxt "case.reports.open"
msgid "Open my reports"
msgstr "Abrir mis informes"

msgctxt "case.reports.ask"
msgid "Ask for my report"
msgstr "Pedir mi informe"

msgctxt "case.score.title"
msgid "There is no single credit score"
msgstr "No existe un solo puntaje de crédito"

msgctxt "case.score.body"
msgid ""
"A landlord, a car dealer and a card company each look at a different one. "
"Worth ten minutes."
msgstr ""
"Un dueño de casa, un vendedor de carros y una compañía de tarjetas miran "
"cada uno uno distinto. Vale diez minutos."

msgctxt "case.score.cta"
msgid "Learn why"
msgstr "Ver por qué"

msgctxt "case.record.title"
msgid "What we already have for you"
msgstr "Lo que ya tenemos de ti"

msgctxt "case.record.body"
msgid ""
"Off your DIN. Nothing here was typed by you, and if any of it is wrong, tell"
" your coordinator."
msgstr ""
"Sale de tu DIN. Nada de esto lo escribiste tú, y si algo está mal, díselo a "
"tu coordinador."

msgctxt "case.helper.title"
msgid "Who is helping you"
msgstr "Quién te está ayudando"

msgctxt "case.helper.live"
msgid ""
"{name} can receive your report at their address and add it. Your own mail "
"still comes to you. The authorization expires {expires}."
msgstr ""
"{name} puede recibir tu informe en su dirección y agregarlo. Tu propio "
"correo sigue llegándote a ti. La autorización vence el {expires}."

msgctxt "case.helper.cannot"
msgid ""
"They cannot open an account in your name, take out credit, move money, or "
"change your address."
msgstr ""
"No pueden abrir una cuenta a tu nombre, sacar crédito, mover dinero ni "
"cambiar tu dirección."

msgctxt "case.helper.review"
msgid "Review or cancel this"
msgstr "Revisar o cancelar esto"

msgctxt "case.helper.none"
msgid ""
"Nobody outside is authorized right now. Ms. Reyes handles it through the "
"program instead. A few steps run slower. Nothing stops."
msgstr ""
"Ahora mismo nadie afuera está autorizado. La Sra. Reyes lo maneja a través "
"del programa. Algunos pasos van más lento. Nada se detiene."

msgctxt "index.title"
msgid "Bridge"
msgstr "Bridge"

msgctxt "index.hero"
msgid "Start the credit work before the gate opens."
msgstr "Empieza el trabajo de crédito antes de que se abra la puerta."

msgctxt "index.lede"
msgid ""
"Bridge runs the credit side of the Offender Case Plan: pull the reports, "
"find the errors, dispute them, and build a file that holds up the first time"
" a landlord or an employer asks for one."
msgstr ""
"Bridge se encarga del lado del crédito del Plan de Caso: conseguir los "
"informes, encontrar los errores, disputarlos y armar un expediente que "
"aguante la primera vez que un dueño de casa o un empleador pida uno."

msgctxt "index.signed_in"
msgid "You are signed in."
msgstr "Ya iniciaste sesión."

msgctxt "index.continue"
msgid "Continue"
msgstr "Continuar"

msgctxt "index.tablet.tag"
msgid "On the tablet"
msgstr "En la tableta"

msgctxt "index.tablet.h"
msgid "If you are inside"
msgstr "Si estás adentro"

msgctxt "index.tablet.body"
msgid ""
"Answer a few questions, see where you stand as a position on a road rather "
"than a score, and watch named people work your case."
msgstr ""
"Responde unas preguntas, mira dónde estás como una posición en un camino y "
"no como un puntaje, y ve a gente con nombre trabajar en tu caso."

msgctxt "index.tablet.cta"
msgid "DIN number or NYS ID"
msgstr "Número de DIN o NYS ID"

msgctxt "index.helper.tag"
msgid "On your phone"
msgstr "En tu teléfono"

msgctxt "index.helper.h"
msgid "If you are helping"
msgstr "Si estás ayudando"

msgctxt "index.helper.body"
msgid ""
"One task at a time. Print a letter, get it signed, drop it in a mailbox, and"
" send the reply in when it lands. Twenty minutes over three months."
msgstr ""
"Una tarea a la vez. Imprime una carta, haz que la firmen, échala al buzón y "
"manda la respuesta cuando llegue. Veinte minutos a lo largo de tres meses."

msgctxt "index.helper.cta"
msgid "Use the code from the letter"
msgstr "Usa el código de la carta"

msgctxt "index.staff.tag"
msgid "At your desk"
msgstr "En tu escritorio"

msgctxt "index.staff.h"
msgid "If you are the coordinator"
msgstr "Si eres el coordinador"

msgctxt "index.staff.body"
msgid ""
"A queue sorted by what expires soonest. Triage in one session, approve the "
"letters, hold the deadline across a caseload."
msgstr ""
"Una fila ordenada por lo que vence primero. Evaluación en una sesión, "
"aprueba las cartas, lleva el plazo de todos los casos."

msgctxt "index.staff.note"
msgid ""
"Opens inside the case plan system you are already signed in to. No second "
"password."
msgstr ""
"Se abre dentro del sistema del plan de caso donde ya iniciaste sesión. Sin "
"segunda contraseña."

msgctxt "index.staff.cta"
msgid "Open the caseload"
msgstr "Abrir los casos"

msgctxt "index.fit.h"
msgid "It fits the plan that already exists"
msgstr "Encaja con el plan que ya existe"

msgctxt "index.fit.p1"
msgid ""
"Bridge is one domain inside the Offender Case Plan the coordinator already "
"keeps, not a second system to maintain. Credit goals go into the plan and "
"progress comes back on the quarterly review cadence."
msgstr ""
"Bridge es un área dentro del Plan de Caso que el coordinador ya lleva, no un"
" segundo sistema que mantener. Las metas de crédito entran al plan y el "
"avance vuelve en el ritmo de revisión trimestral."

msgctxt "index.fit.p2"
msgid ""
"The vital documents packet reentry staff already assemble is the same "
"paperwork a credit bureau asks for, so it gets used rather than collected "
"twice."
msgstr ""
"El paquete de documentos vitales que el personal de reinserción ya arma es "
"el mismo papeleo que pide un buró de crédito, así que se aprovecha en vez de"
" reunirse dos veces."

msgctxt "index.restart"
msgid "Walking this more than once?"
msgstr "¿Vas a recorrer esto más de una vez?"

msgctxt "index.restart.link"
msgid "Start somebody over"
msgstr "Empezar de nuevo con alguien"

msgctxt "index.restart.tail"
msgid ""
"puts one person back to the seed, so the PIN and the intake can be done "
"again."
msgstr ""
"devuelve a una persona al punto de partida, para poder repetir el PIN y las "
"preguntas."

msgctxt "index.colophon"
msgid ""
"Bridge is an independent tool built for reentry programs in New York State. "
"It is not affiliated with, endorsed by, or operated by the New York State "
"Department of Corrections and Community Supervision or any correctional "
"facility."
msgstr ""
"Bridge es una herramienta independiente hecha para programas de reinserción "
"en el estado de Nueva York. No está afiliada, respaldada ni operada por el "
"Departamento de Correccionales y Supervisión Comunitaria del Estado de Nueva"
" York ni por ninguna institución correccional."

msgctxt "denied.title"
msgid "Not possible from this surface"
msgstr "No es posible desde esta pantalla"

msgctxt "after.title"
msgid "When you go home"
msgstr "Cuando vuelvas a casa"

msgctxt "after.heading"
msgid "Somebody to keep working with."
msgstr "Alguien con quien seguir trabajando."

msgctxt "after.lede"
msgid ""
"A dispute can still be running when you walk out, and by then your "
"coordinator is no longer holding it. Some cities have a free financial "
"counselor who does credit reports, debt and disputes. Not a loan, not a "
"grant, no charge, ever."
msgstr ""
"Una disputa puede seguir en marcha cuando salgas, y para entonces tu "
"coordinador ya no la lleva. Algunas ciudades tienen un consejero financiero "
"gratuito que atiende informes de crédito, deudas y disputas. No es un "
"préstamo ni una beca, y nunca cobra."

msgctxt "after.free.title"
msgid "Nobody here can charge you to fix your credit."
msgstr "Nadie aquí puede cobrarte por arreglar tu crédito."

msgctxt "after.free.body"
msgid ""
"A company that asks for money before the work is done is breaking the law. "
"That is in the course, and it is the single most useful thing to remember in"
" your first month out."
msgstr ""
"Una empresa que pide dinero antes de hacer el trabajo está violando la ley. "
"Eso está en el curso, y es lo más útil que puedes recordar en tu primer mes "
"afuera."

msgctxt "after.where.label"
msgid "Where are you going home to?"
msgstr "¿A dónde vas a volver a casa?"

msgctxt "after.where.hint"
msgid ""
"County. If you are not sure yet, you can come back to this screen any time."
msgstr ""
"Condado. Si todavía no estás seguro, puedes volver a esta pantalla cuando "
"quieras."

msgctxt "after.choose"
msgid "Choose a county"
msgstr "Elige un condado"

msgctxt "after.show"
msgid "Show me"
msgstr "Muéstrame"

msgctxt "after.open"
msgid "Open now"
msgstr "Abierto ahora"

msgctxt "after.book"
msgid "How to get an appointment"
msgstr "Cómo conseguir una cita"

msgctxt "after.write_down"
msgid ""
"Write the number down before you go. You will not have this tablet on the "
"outside."
msgstr "Anota el número antes de salir. No vas a tener esta tableta afuera."

msgctxt "after.cite"
msgid "{source} · checked {date}"
msgstr "{source} · revisado el {date}"

msgctxt "after.coming"
msgid "Not open yet"
msgstr "Todavía no abre"

msgctxt "after.unchecked.tag"
msgid "We have not checked this one"
msgstr "Este no lo hemos revisado"

msgctxt "after.unchecked.body"
msgid ""
"There may be a center serving {county}, but nobody on this team has read the"
" page it comes from, so we are not going to put an address in front of you "
"that we have not opened ourselves. Ask your coordinator to look it up with "
"you."
msgstr ""
"Puede que haya un centro que atienda {county}, pero nadie de este equipo ha "
"leído la página de donde viene, así que no vamos a ponerte delante una "
"dirección que no hemos abierto nosotros mismos. Pídele a tu coordinador que "
"la busque contigo."

msgctxt "after.unchecked.note"
msgid ""
"An address that has moved sends somebody who has just come home on a bus "
"ride to a locked door. That is why this screen would rather say nothing."
msgstr ""
"Una dirección que cambió manda a alguien que acaba de volver a casa en un "
"viaje de autobús hasta una puerta cerrada. Por eso esta pantalla prefiere no"
" decir nada."

msgctxt "after.none.tag"
msgid "No center there"
msgstr "No hay centro allí"

msgctxt "after.none.body"
msgid ""
"There is no free city-run financial counselor in {county}. Most of New York "
"State has none: it is a city program, and it covers a handful of places. We "
"are not going to send you to the nearest one, because two hours on a bus to "
"a desk that will turn you away is worse than knowing now."
msgstr ""
"No hay un consejero financiero gratuito de la ciudad en {county}. La mayor "
"parte del estado de Nueva York no tiene ninguno: es un programa de ciudad y "
"cubre unos pocos lugares. No te vamos a mandar al más cercano, porque dos "
"horas en autobús hasta un escritorio que te va a rechazar es peor que "
"saberlo ahora."

msgctxt "after.none.h"
msgid "What to do instead"
msgstr "Qué hacer en su lugar"

msgctxt "after.none.do"
msgid ""
"Finish the course. It covers the two rules that matter most out there: "
"nobody may charge you before the work is done, and you are owed a free "
"report from all three bureaus every year, plus another one every time you "
"are turned down for something."
msgstr ""
"Termina el curso. Cubre las dos reglas que más importan afuera: nadie puede "
"cobrarte antes de terminar el trabajo, y tienes derecho a un informe gratis "
"de los tres burós cada año, más otro cada vez que te nieguen algo."

msgctxt "after.none.cta"
msgid "Back to the course"
msgstr "Volver al curso"

msgctxt "after.colophon"
msgid ""
"This list is kept by hand and checked on {checked_on}. Only places somebody "
"on this team has read about are on it."
msgstr ""
"Esta lista se lleva a mano y se revisó el {checked_on}. Solo están los "
"lugares sobre los que alguien de este equipo ha leído."

msgctxt "borough.Bronx"
msgid "the Bronx"
msgstr "el Bronx"

msgctxt "borough.Kings"
msgid "Brooklyn"
msgstr "Brooklyn"

msgctxt "borough.New York"
msgid "Manhattan"
msgstr "Manhattan"

msgctxt "borough.Queens"
msgid "Queens"
msgstr "Queens"

msgctxt "borough.Richmond"
msgid "Staten Island"
msgstr "Staten Island"

msgctxt "auth.title"
msgid "Who is helping you"
msgstr "Quién te está ayudando"

msgctxt "auth.since"
msgid "{name}, since {signed}"
msgstr "{name}, desde el {signed}"

msgctxt "auth.expires"
msgid "Expires {expires}. Acting under a {standing}."
msgstr "Vence el {expires}. Actúa mediante {standing}."

msgctxt "auth.enough.title"
msgid "Nobody gets more than they need"
msgstr "Nadie recibe más de lo que necesita"

msgctxt "auth.enough.body"
msgid ""
"Whoever helps you cannot open an account in your name, take out credit, move"
" money, or change your address. If a bureau ever needs you to sign something"
" extra, you see exactly what it says first."
msgstr ""
"Quien te ayude no puede abrir una cuenta a tu nombre, sacar crédito, mover "
"dinero ni cambiar tu dirección. Si algún buró alguna vez necesita que firmes"
" algo extra, primero ves exactamente lo que dice."

msgctxt "auth.cancel"
msgid "Cancel this authorization"
msgstr "Cancelar esta autorización"

msgctxt "auth.cancel_note"
msgid ""
"You can cancel from this screen without telling {name} first. Ms. Reyes is "
"told the same day."
msgstr ""
"Puedes cancelar desde esta pantalla sin avisarle antes a {name}. La Sra. "
"Reyes se entera el mismo día."

msgctxt "auth.none.title"
msgid "Nobody outside right now"
msgstr "Nadie afuera por ahora"

msgctxt "auth.none.body"
msgid ""
"Ms. Reyes handles it through the program instead, using the same form you "
"already signed with her. A few steps run slower. Nothing stops."
msgstr ""
"La Sra. Reyes lo maneja a través del programa, con el mismo formulario que "
"ya firmaste con ella. Algunos pasos van más lento. Nada se detiene."

msgctxt "auth.name_label"
msgid "Name someone you trust"
msgstr "Nombra a alguien de confianza"

msgctxt "auth.name_placeholder"
msgid "First name"
msgstr "Nombre de pila"

msgctxt "auth.invite"
msgid "Send them the invitation"
msgstr "Enviarle la invitación"

msgctxt "standing.signed_form"
msgid "Signed form"
msgstr "Formulario firmado"

msgctxt "standing.notarized_poa"
msgid "Limited power of attorney"
msgstr "Poder notarial limitado"

msgctxt "scope.receive_mail"
msgid "Receive the report at their own address"
msgstr "Recibir el informe en su propia dirección"

msgctxt "scope.submit_report_images"
msgid "Add photos of the reports"
msgstr "Agregar fotos de los informes"

msgctxt "scope.mail_dispute_letter"
msgid "Mail a letter we print"
msgstr "Enviar por correo una carta que imprimimos"

msgctxt "scope.be_contacted_by_staff"
msgid "Be contacted by the counselor"
msgstr "Que lo contacte el consejero"

msgctxt "scope.open_account"
msgid "Open an account"
msgstr "Abrir una cuenta"

msgctxt "scope.apply_for_credit"
msgid "Apply for credit"
msgstr "Solicitar crédito"

msgctxt "scope.move_money"
msgid "Move money"
msgstr "Mover dinero"

msgctxt "scope.change_address"
msgid "Change the address on file"
msgstr "Cambiar la dirección en el expediente"

msgctxt "scope.view_ssn"
msgid "See the Social Security number"
msgstr "Ver el número de Seguro Social"

msgctxt "scope.view_full_account_numbers"
msgid "See full account numbers"
msgstr "Ver los números de cuenta completos"

msgctxt "request.title"
msgid "Ask for your report"
msgstr "Pide tu informe"

msgctxt "request.suffix"
msgid "Your report"
msgstr "Tu informe"

msgctxt "request.asked.tag"
msgid "Asked for"
msgstr "Pedido"

msgctxt "request.asked.h"
msgid "It is on its way."
msgstr "Va en camino."

msgctxt "request.asked.lede"
msgid ""
"Your coordinator has the request. It goes out on paper, and the bureaus have"
" 15 days from getting it to send your file back here."
msgstr ""
"Tu coordinador tiene la solicitud. Sale en papel, y los burós tienen 15 días"
" desde que la reciben para enviarte tu expediente aquí."

msgctxt "request.h"
msgid "You can do this on your own."
msgstr "Puedes hacer esto por tu cuenta."

msgctxt "request.lede"
msgid ""
"You do not need anybody on the outside to get your credit report. Not a "
"family member, not a friend, not a lawyer. One form, one address, all three "
"bureaus."
msgstr ""
"No necesitas a nadie afuera para conseguir tu informe de crédito. Ni un "
"familiar, ni un amigo, ni un abogado. Un formulario, una dirección, los tres"
" burós."

msgctxt "request.notest.title"
msgid "There is no test to pass."
msgstr "No hay ningún examen que pasar."

msgctxt "request.notest.body"
msgid ""
"Online, a bureau asks you questions about old addresses and car loans before"
" it will show you anything. That is a web page, and you cannot reach it. "
"This route is paper, so there is nothing to fail."
msgstr ""
"En internet, un buró te hace preguntas sobre direcciones viejas y préstamos "
"de carro antes de mostrarte algo. Eso es una página web, y no puedes llegar "
"a ella. Esta vía es en papel, así que no hay nada que reprobar."

msgctxt "request.how"
msgid "How it works"
msgstr "Cómo funciona"

msgctxt "request.step1"
msgid "You ask. Your coordinator prints the letter below and you sign it."
msgstr "Tú lo pides. Tu coordinador imprime la carta de abajo y tú la firmas."

msgctxt "request.step2"
msgid ""
"If anything needs to be sworn, the law library has a notary. They have to "
"get you one within 72 hours of asking."
msgstr ""
"Si algo tiene que jurarse, la biblioteca legal tiene un notario. Tienen que "
"conseguirte uno dentro de las 72 horas después de pedirlo."

msgctxt "request.step3"
msgid ""
"It goes to one address in Atlanta and covers Equifax, Experian and "
"TransUnion together."
msgstr ""
"Va a una sola dirección en Atlanta y cubre a Equifax, Experian y TransUnion "
"juntos."

msgctxt "request.step4"
msgid ""
"Your file comes back here as mail, in your name. You carry it to your "
"coordinator and you read it on this screen."
msgstr ""
"Tu expediente vuelve aquí como correo, a tu nombre. Se lo llevas a tu "
"coordinador y lo lees en esta pantalla."

msgctxt "request.ask"
msgid "Ask for my report"
msgstr "Pedir mi informe"

msgctxt "request.ask_note"
msgid ""
"This tells your coordinator. Nothing is sent anywhere until you have signed "
"it yourself."
msgstr ""
"Esto se lo avisa a tu coordinador. No se envía nada a ninguna parte hasta "
"que lo hayas firmado tú mismo."

msgctxt "request.waiting.title"
msgid "Nothing is waiting on you right now."
msgstr "Nada depende de ti ahora mismo."

msgctxt "request.waiting.body"
msgid ""
"Your coordinator prints it and brings it to you to sign. While you wait, the"
" course is the useful thing to do: the lesson on reading a report is the one"
" that pays off the day yours arrives."
msgstr ""
"Tu coordinador la imprime y te la trae para que la firmes. Mientras esperas,"
" lo útil es el curso: la lección sobre cómo leer un informe es la que rinde "
"el día que llegue el tuyo."

msgctxt "request.waiting.cta"
msgid "Go to the course"
msgstr "Ir al curso"

msgctxt "request.letter.h"
msgid "The letter"
msgstr "La carta"

msgctxt "request.letter.lede"
msgid ""
"This is what goes out, in your name, to your address here. It stays in "
"English because the bureaus read it in English."
msgstr ""
"Esto es lo que sale, a tu nombre, a tu dirección aquí. Se queda en inglés "
"porque los burós la leen en inglés."

msgctxt "request.letter.note"
msgid ""
"The Social Security number and date of birth lines are blank on purpose. "
"They go on the paper by hand and are never typed into this app."
msgstr ""
"Las líneas del número de Seguro Social y la fecha de nacimiento están en "
"blanco a propósito. Se escriben a mano en el papel y nunca se teclean en "
"esta aplicación."

msgctxt "request.cite"
msgid "{source} · checked {date}"
msgstr "{source} · revisado el {date}"

msgctxt "scores.title"
msgid "Why there is no single score"
msgstr "Por qué no existe un solo puntaje"

msgctxt "scores.suffix"
msgid "Credit scores"
msgstr "Puntajes de crédito"

msgctxt "scores.h"
msgid "There is no such thing as your credit score."
msgstr "No existe algo así como tu puntaje de crédito."

msgctxt "scores.lede"
msgid "There are dozens of them, and they disagree on purpose."
msgstr "Hay docenas, y no coinciden a propósito."

msgctxt "scores.three"
msgid "Three things multiply together"
msgstr "Tres cosas se multiplican entre sí"

msgctxt "scores.bureau.h"
msgid "Which bureau"
msgstr "Cuál buró"

msgctxt "scores.bureau.b"
msgid ""
"Equifax, Experian and TransUnion hold different files. Not every lender "
"reports to all three, so an account on one report can be missing from "
"another."
msgstr ""
"Equifax, Experian y TransUnion tienen expedientes distintos. No todos los "
"prestamistas reportan a los tres, así que una cuenta en un informe puede "
"faltar en otro."

msgctxt "scores.model.h"
msgid "Which model"
msgstr "Cuál modelo"

msgctxt "scores.model.b"
msgid ""
"FICO and VantageScore are different companies. FICO alone has versions 2 "
"through 10T still in use, and they do not agree with each other."
msgstr ""
"FICO y VantageScore son empresas distintas. Solo FICO tiene versiones desde "
"la 2 hasta la 10T todavía en uso, y no coinciden entre sí."

msgctxt "scores.industry.h"
msgid "Which industry"
msgstr "Cuál industria"

msgctxt "scores.industry.b"
msgid ""
"A car lender and a card issuer use scores tuned to their own risk, on a "
"different scale entirely."
msgstr ""
"Un prestamista de carros y un emisor de tarjetas usan puntajes ajustados a "
"su propio riesgo, en una escala totalmente distinta."

msgctxt "scores.pulled"
msgid "What gets pulled, and when"
msgstr "Qué se consulta, y cuándo"

msgctxt "scores.questions"
msgid "The questions people actually ask"
msgstr "Las preguntas que la gente realmente hace"

msgctxt "scores.nonumber.h"
msgid "Which is why this app does not show you a number"
msgstr "Por eso esta aplicación no te muestra un número"

msgctxt "scores.nonumber.b"
msgid ""
"A number with no model, no bureau and no date attached is not information. "
"It is a guess that feels precise. What it shows you instead is what is "
"actually on your file, and what moves it."
msgstr ""
"Un número sin modelo, sin buró y sin fecha no es información. Es una "
"suposición que se siente precisa. Lo que te muestra en su lugar es lo que "
"realmente hay en tu expediente, y qué lo mueve."

msgctxt "scores.summary"
msgid ""
"About {n} different scores can describe one person on one day: {models} "
"widely used models against 3 bureau files. Base scores run {b1} to {b2}; "
"auto and card scores run {i1} to {i2}."
msgstr ""
"Unos {n} puntajes distintos pueden describir a una persona en un mismo día: "
"{models} modelos de uso amplio contra 3 expedientes de buró. Los puntajes "
"base van de {b1} a {b2}; los de carro y tarjeta van de {i1} a {i2}."

msgctxt "scores.range"
msgid "{low} to {high}"
msgstr "{low} a {high}"

msgctxt "report.title"
msgid "Your credit report"
msgstr "Tu informe de crédito"

msgctxt "report.suffix"
msgid "Your reports"
msgstr "Tus informes"

msgctxt "report.waiting.one"
msgid "1 report is here. Your counselor is checking it."
msgstr "Hay 1 informe aquí. Tu consejero lo está revisando."

msgctxt "report.waiting.many"
msgid "{n} reports are here. Your counselor is checking them."
msgstr "Hay {n} informes aquí. Tu consejero los está revisando."

msgctxt "report.waiting.line"
msgid "{bureau} · {source}, {scanned}"
msgstr "{bureau} · {source}, {scanned}"

msgctxt "report.waiting.why"
msgid ""
"They read it against the paper before it goes on this screen, because what "
"is written here becomes a letter to a credit bureau. Nothing is wrong. It is"
" the checking step."
msgstr ""
"Lo comparan con el papel antes de que salga en esta pantalla, porque lo que "
"se escribe aquí se convierte en una carta a un buró de crédito. No hay "
"ningún problema. Es el paso de revisión."

msgctxt "report.not_yet"
msgid "Not on this screen yet."
msgstr "Todavía no está en esta pantalla."

msgctxt "report.nothing"
msgid "Nothing here yet."
msgstr "Todavía no hay nada aquí."

msgctxt "report.arrive"
msgid ""
"Your reports come back on paper. When they arrive, bring them to your "
"coordinator and they will scan them into your record. Then you can read them"
" here."
msgstr ""
"Tus informes llegan en papel. Cuando lleguen, llévaselos a tu coordinador y "
"los escaneará a tu expediente. Después puedes leerlos aquí."

msgctxt "report.ask.title"
msgid "You can ask for them yourself."
msgstr "Puedes pedirlos tú mismo."

msgctxt "report.ask.body"
msgid ""
"You do not need anybody on the outside to do this. One form covers all three"
" bureaus, it goes out in your name, and it comes back here."
msgstr ""
"No necesitas a nadie afuera para hacerlo. Un formulario cubre los tres "
"burós, sale a tu nombre y vuelve aquí."

msgctxt "report.ask.cta"
msgid "Ask for my report"
msgstr "Pedir mi informe"

msgctxt "report.nophoto.h"
msgid "You do not photograph anything"
msgstr "Tú no fotografías nada"

msgctxt "report.nophoto.b"
msgid ""
"There is no camera in this app and there does not need to be. The paper goes"
" to your coordinator, the coordinator scans it, and it shows up here."
msgstr ""
"Esta aplicación no tiene cámara y no hace falta. El papel va a tu "
"coordinador, él lo escanea y aparece aquí."

msgctxt "report.back_case"
msgid "Back to my case"
msgstr "Volver a mi caso"

msgctxt "report.scores.h"
msgid "Your scores"
msgstr "Tus puntajes"

msgctxt "report.scores.sub"
msgid "Same person. Same week. Three different numbers."
msgstr "La misma persona. La misma semana. Tres números distintos."

msgctxt "report.pulled_card"
msgid "Pulled {date}"
msgstr "Consultado el {date}"

msgctxt "report.apart"
msgid "{n} points apart, and nothing is broken."
msgstr "{n} puntos de diferencia, y nada está roto."

msgctxt "report.apart.body"
msgid "Each bureau keeps its own file on you and yours do not match."
msgstr "Cada buró lleva su propio expediente tuyo y los tuyos no coinciden."

msgctxt "report.apart.counts"
msgid ""
"{most} is reporting {most_n} accounts and {fewest} only {fewest_n}, so one "
"of them is carrying something the other has never heard of."
msgstr ""
"{most} reporta {most_n} cuentas y {fewest} solo {fewest_n}, así que uno de "
"ellos tiene algo de lo que el otro nunca ha oído hablar."

msgctxt "report.apart.tail"
msgid ""
"Whichever one a landlord or a lender pulls is the one that decides about "
"you, which is why the work is on the file rather than on chasing a number."
msgstr ""
"El que consulte un dueño de casa o un prestamista es el que decide sobre ti,"
" y por eso el trabajo está en el expediente y no en perseguir un número."

msgctxt "report.why_no_score"
msgid "Why there is no single score"
msgstr "Por qué no existe un solo puntaje"

msgctxt "report.read_with_me"
msgid "Read it with me"
msgstr "Léelo conmigo"

msgctxt "report.arrival.body"
msgid ""
"Your {bureau} report is here and nobody has read it with you yet. It takes "
"about five minutes and it explains itself as you go."
msgstr ""
"Tu informe de {bureau} ya está aquí y todavía nadie lo ha leído contigo. "
"Toma unos cinco minutos y se explica solo sobre la marcha."

msgctxt "report.h"
msgid "Your credit reports."
msgstr "Tus informes de crédito."

msgctxt "report.ssn.h"
msgid "Your Social Security number is blacked out"
msgstr "Tu número de Seguro Social está tachado"

msgctxt "report.ssn.b"
msgid ""
"Only the last four digits appear, on every page. The request asked them to "
"leave the first five out, which the law lets you require, and this screen "
"covers them again regardless."
msgstr ""
"Solo aparecen los últimos cuatro dígitos, en cada página. La solicitud les "
"pidió omitir los primeros cinco, algo que la ley te permite exigir, y esta "
"pantalla los vuelve a tapar de todos modos."

msgctxt "report.read_on"
msgid "You read this on {date}"
msgstr "Leíste esto el {date}"

msgctxt "report.again"
msgid "Go through it again"
msgstr "Repasarlo otra vez"

msgctxt "report.pulled_line"
msgid "Pulled {pulled} · scanned in {scanned} by {by}"
msgstr "Consultado el {pulled} · escaneado el {scanned} por {by}"

msgctxt "report.about"
msgid "About you, as they have it"
msgstr "Sobre ti, como lo tienen ellos"

msgctxt "report.score"
msgid "Score"
msgstr "Puntaje"

msgctxt "report.accounts"
msgid "Accounts"
msgstr "Cuentas"

msgctxt "report.opened"
msgid "opened {date}"
msgstr "abierta {date}"

msgctxt "report.disputed"
msgid "Disputed"
msgstr "En disputa"

msgctxt "report.none"
msgid ""
"No accounts on file with this bureau. That is not the same as bad credit, "
"and it moves faster than damaged does."
msgstr ""
"No hay cuentas en el expediente de este buró. Eso no es lo mismo que mal "
"crédito, y avanza más rápido que uno dañado."

msgctxt "report.public"
msgid "Public records"
msgstr "Registros públicos"

msgctxt "report.pdf"
msgid "Save as PDF"
msgstr "Guardar como PDF"

msgctxt "report.why_no_score_q"
msgid "Why is there no score?"
msgstr "¿Por qué no hay puntaje?"

msgctxt "report.born"
msgid "Born {year}"
msgstr "Nació en {year}"

msgctxt "report.not_shown"
msgid "Not shown"
msgstr "No se muestra"

msgctxt "report.ending"
msgid "ending {last4}"
msgstr "terminada en {last4}"

msgctxt "report.withheld"
msgid "number withheld"
msgstr "número omitido"

msgctxt "report.no_score"
msgid ""
"No score on this report. A file disclosure does not have to include one, and"
" most mailed reports do not."
msgstr ""
"No hay puntaje en este informe. Una divulgación de expediente no tiene que "
"incluirlo, y la mayoría de los informes por correo no lo traen."

msgctxt "report.sum.none"
msgid "No accounts on file with this bureau."
msgstr "No hay cuentas en el expediente de este buró."

msgctxt "report.sum.accounts.one"
msgid "{n} account"
msgstr "{n} cuenta"

msgctxt "report.sum.accounts.many"
msgid "{n} accounts"
msgstr "{n} cuentas"

msgctxt "report.sum.disputed"
msgid "{n} disputed"
msgstr "{n} en disputa"

msgctxt "report.sum.records.one"
msgid "{n} public record"
msgstr "{n} registro público"

msgctxt "report.sum.records.many"
msgid "{n} public records"
msgstr "{n} registros públicos"

msgctxt "readdone.title"
msgid "You have read your {bureau} report"
msgstr "Leíste tu informe de {bureau}"

msgctxt "readdone.body"
msgid ""
"You have now read your own {bureau} credit report, start to finish. Whatever"
" happens next on this case, that part is done and it was the hard part."
msgstr ""
"Ya leíste tu propio informe de crédito de {bureau}, de principio a fin. Pase"
" lo que pase después en este caso, esa parte está hecha y era la difícil."

msgctxt "readdone.pulled"
msgid "Pulled {pulled} · {source}, {scanned} by {by}"
msgstr "Consultado el {pulled} · {source}, {scanned} por {by}"

msgctxt "readdone.said"
msgid "What you said, and what happens now"
msgstr "Lo que dijiste, y qué pasa ahora"

msgctxt "readdone.flagged.one"
msgid "You flagged 1 item:"
msgstr "Marcaste 1 partida:"

msgctxt "readdone.flagged.many"
msgid "You flagged {n} items:"
msgstr "Marcaste {n} partidas:"

msgctxt "readdone.check"
msgid ""
"Your coordinator checks these against the paper before anything is sent. "
"That is the step that stops a letter going out about the wrong account."
msgstr ""
"Tu coordinador las revisa contra el papel antes de que se envíe nada. Ese es"
" el paso que evita que salga una carta sobre la cuenta equivocada."

msgctxt "readdone.another.h"
msgid "You have another report to read"
msgstr "Tienes otro informe por leer"

msgctxt "readdone.another.b"
msgid ""
"Each bureau keeps its own file, and they do not match. An item on this one "
"may be missing from the next."
msgstr ""
"Cada buró lleva su propio expediente, y no coinciden. Algo que está en este "
"puede faltar en el siguiente."

msgctxt "readdone.another.cta"
msgid "Read the next one"
msgstr "Leer el siguiente"

msgctxt "readdone.again.h"
msgid "Any of this can be read again"
msgstr "Todo esto se puede volver a leer"

msgctxt "readdone.again.b"
msgid ""
"Your report stays on this screen, with your Social Security number blacked "
"out, for as long as your case is open."
msgstr ""
"Tu informe se queda en esta pantalla, con tu número de Seguro Social "
"tachado, mientras tu caso esté abierto."

msgctxt "readdone.my_reports"
msgid "My reports"
msgstr "Mis informes"

msgctxt "readdone.my_case"
msgid "My case"
msgstr "Mi caso"

msgctxt "walk.title"
msgid "Reading your {bureau} report"
msgstr "Leyendo tu informe de {bureau}"

msgctxt "walk.suffix"
msgid "Reading it together"
msgstr "Leyéndolo juntos"

msgctxt "walk.progress"
msgid "{n} of {total}"
msgstr "{n} de {total}"

msgctxt "walk.saved"
msgid "Saved as you go. You can stop and come back to this."
msgstr "Se guarda sobre la marcha. Puedes parar y volver a esto."

msgctxt "walk.only_you"
msgid ""
"You are the only person who knows this. Nobody else can tell whether you "
"opened an account in 2016."
msgstr ""
"Tú eres la única persona que lo sabe. Nadie más puede decir si abriste una "
"cuenta en 2016."

msgctxt "walk.tick.h"
msgid "If something is not yours, tick it"
msgstr "Si algo no es tuyo, márcalo"

msgctxt "walk.tick.b"
msgid ""
"Only if you are telling us something is wrong. Leave them all unticked if "
"you recognize everything."
msgstr ""
"Solo si nos estás diciendo que algo está mal. Déjalas todas sin marcar si "
"reconoces todo."

msgctxt "walk.nosend"
msgid ""
"Saying this does not send anything yet. Your coordinator checks what you "
"flag against the paper first, because a letter about the wrong account "
"number is worse than no letter."
msgstr ""
"Decir esto todavía no envía nada. Tu coordinador revisa primero lo que "
"marques contra el papel, porque una carta sobre el número de cuenta "
"equivocado es peor que ninguna carta."

msgctxt "walk.answer"
msgid "That's my answer"
msgstr "Esa es mi respuesta"

msgctxt "walk.no_address"
msgid "No address history on this copy."
msgstr "No hay historial de direcciones en esta copia."

msgctxt "walk.flagged"
msgid "Already flagged"
msgstr "Ya marcada"

msgctxt "walk.missing"
msgid ""
"Nothing on this report says anything about rent you paid, a phone bill you "
"kept up, or the lights staying on."
msgstr ""
"Nada en este informe dice algo sobre la renta que pagaste, una cuenta de "
"teléfono que mantuviste al día o la luz que siguió encendida."

msgctxt "walk.means"
msgid "What this part means"
msgstr "Qué significa esta parte"

msgctxt "walk.full_lesson"
msgid "Full lesson: {lesson}"
msgstr "Lección completa: {lesson}"

msgctxt "walk.last"
msgid "Last part, then one question"
msgstr "Última parte, y luego una pregunta"

msgctxt "walk.next"
msgid "Next part"
msgstr "Siguiente parte"

msgctxt "walk.stop"
msgid "Stop for now"
msgstr "Parar por ahora"

msgctxt "timeline.mailed"
msgid "Denise mailed the request for your report"
msgstr "Denise envió por correo la solicitud de tu informe"

msgctxt "timeline.came_back"
msgid "It came back. Two things look wrong."
msgstr "Volvió. Dos cosas se ven mal."

msgctxt "timeline.approved"
msgid "Ms. Reyes approved your dispute letter"
msgstr "La Sra. Reyes aprobó tu carta de disputa"

msgctxt "timeline.waiting"
msgid "Waiting on their answer, due {when}"
msgstr "Esperando su respuesta, para el {when}"

msgctxt "timeline.opened"
msgid "Ms. Reyes opened your case"
msgstr "La Sra. Reyes abrió tu caso"

msgctxt "timeline.agreed"
msgid "{name} agreed to help"
msgstr "{name} aceptó ayudar"

msgctxt "timeline.request_mailed"
msgid "Request mailed to the bureaus"
msgstr "Solicitud enviada por correo a los burós"

msgctxt "timeline.dispute_handed"
msgid "Your dispute letter to {bureau} was handed in to the coordinator"
msgstr "Tu carta de disputa a {bureau} fue entregada a la coordinadora"

msgctxt "timeline.dispute_mailed"
msgid "Your dispute letter to {bureau} was mailed"
msgstr "Tu carta de disputa a {bureau} fue enviada por correo"

msgctxt "timeline.dispute_certified"
msgid ""
"Your dispute letter to {bureau} was mailed, certified, tracking number "
"{number}"
msgstr ""
"Tu carta de disputa a {bureau} fue enviada por correo, certificada, número "
"de rastreo {number}"

msgctxt "timeline.request_certified"
msgid "Request mailed to the bureaus, certified, tracking number {number}"
msgstr ""
"Solicitud enviada por correo a los burós, certificada, número de rastreo "
"{number}"

msgctxt "timeline.checked"
msgid "Your {bureau} report was checked and added to your record"
msgstr "Tu informe de {bureau} fue revisado y agregado a tu expediente"

msgctxt "timeline.scanned"
msgid "Your {bureau} report was scanned into your record"
msgstr "Tu informe de {bureau} fue escaneado a tu expediente"

msgctxt "timeline.document"
msgid "Your {document} is on file"
msgstr "Tu documento está archivado: {document}"

msgctxt "timeline.lesson"
msgid "You finished the lesson on {lesson}"
msgstr "Terminaste la lección sobre {lesson}"

msgctxt "timeline.asked"
msgid "You asked for your credit report from all three bureaus"
msgstr "Pediste tu informe de crédito a los tres burós"

msgctxt "timeline.read"
msgid ""
"You read your {bureau} report and said what you did and did not recognize"
msgstr "Leíste tu informe de {bureau} y dijiste qué reconocías y qué no"

msgctxt "timeline.cancelled"
msgid "You cancelled the authorization"
msgstr "Cancelaste la autorización"

msgctxt "timeline.pdf"
msgid "The report came in as a PDF"
msgstr "El informe llegó como PDF"

msgctxt "timeline.typed"
msgid "They typed your report in by hand"
msgstr "Escribieron tu informe a mano"

msgctxt "timeline.photo"
