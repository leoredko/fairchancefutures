msgstr "Terminaste el curso"

msgctxt "end.heading"
msgid "You finished the whole course."
msgstr "Terminaste todo el curso."

msgctxt "end.lede"
msgid ""
"All {total} lessons. About {minutes} minutes of it. You know more about how "
"credit actually works than most people who have never been inside."
msgstr ""
"Las {total} lecciones. Unos {minutes} minutos. Sabes más sobre cómo funciona"
